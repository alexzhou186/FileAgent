# Optional. You can enter and remember a key in the FileAgent browser UI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional. Defaults to the project's ignored workspace/ directory.
# Use a dedicated folder containing only files that may be sent to DeepSeek.
# FILEAGENT_WORKSPACE=/absolute/path/to/FileAgentWorkspace

# Per HTTP attempt. The SDK retries transient errors up to this number of times.
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
